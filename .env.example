# Copy to .env (chmod 0600) and edit. docker compose reads it for variable substitution and passes it to the container.
# Never commit .env.

# --- Required ---
# Public URL users open in the browser. Must match the GitLab OAuth redirect URI prefix (<BASE_URL>/auth/callback). https => Secure cookies.
BASE_URL=http://localhost:3000
# Your GitLab base URL.
GITLAB_URL=https://gitlab.example.com
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing it makes every stored token undecryptable: back it up somewhere safe.
ARGUS_MASTER_KEY=

# --- Optional ---
# GitLab OAuth application credentials. Leave empty to enter them on the first-run /setup page (stored encrypted).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# GitLab user id (preferred) or username that becomes owner on first login, only while no owner exists.
ARGUS_OWNER=
# Jira Server / Data Center only (Bearer token, REST v2). Leave both empty to disable Jira requirement context.
JIRA_URL=
JIRA_API_TOKEN=
# Publish mode. Leave EMPTY to manage it on /admin (default: dry-run). If set it locks the toggle; only 0 = live (posts comments).
DRY_RUN=
# Host port to publish (container always listens on 3000).
ARGUS_PORT=3000
# Max reviews running at once across users.
REVIEW_CONCURRENCY=3
# Seconds between poll cycles.
POLL_INTERVAL_SEC=30
